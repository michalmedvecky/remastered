    "DUNE.ENG:279": "Vojevůdce",
    "DUNE.ENG:280": "Vrchní vojevůdce",
    "DUNE.ENG:281": "Vládce Arrakisu",
    "DUNE.ENG:282": "Imperátor",
    "DUNE.ENG:283": "Na Dunu dorazily tři rody.",
    "DUNE.ENG:284": "Chtějí ovládnout území.",
    "DUNE.ENG:285": "To je však rozděleno.",
    "DUNE.ENG:286": "Vyberte další oblast",
    "DUNE.ENG:287": "V imperátorově paláci.",
    "DUNE.ENG:288": "Právě vy byste měli\rchápat, jak důležité je vítězství!",
    "DUNE.ENG:289": "Ano, Vaše Excelence. Já...",
    "DUNE.ENG:290": "Nechali jste Atreidy porazit\rvás i mé Sardaukary!",
    "DUNE.ENG:291": "Nenechal jsem...",
    "DUNE.ENG:292": "Podruhé to nedovolím!",
    "DUNE.ENG:293": "V imperátorově paláci\rna Duně.",
    "DUNE.ENG:294": "Hlupáci!\rDal jsem vám zbraně i vojáky.",
    "DUNE.ENG:295": "A přesto nedokážete\rporazit Atreidy.",
    "DUNE.ENG:296": "Ale, Excel...",
    "DUNE.ENG:297": "Dost!  Společně musíme\rAtreidům zabránit ve vítězství!",
    "DUNE.ENG:298": "V imperátorově paláci.",
    "DUNE.ENG:299": "Nemohu uvěřit té\rneschopnosti, kterou tu vidím!",
    "DUNE.ENG:300": "Vaše Výsosti?",
    "DUNE.ENG:301": "Poslal jsem vám své Sardaukary\rproti Ordosům, a vy jste zklamali!",
    "DUNE.ENG:302": "My...",
    "DUNE.ENG:303": "Znovu mě nezklamte!\rMůžete jít!",
    "DUNE.ENG:304": "V imperátorově paláci\rna Duně.",
    "DUNE.ENG:305": "Ordosové neměli\rdojít tak daleko!",
    "DUNE.ENG:306": "Vaše Výsosti, vysvětlíme vám...",
    "DUNE.ENG:307": "Žádné další výmluvy!\rBudete bránit můj palác.",
    "DUNE.ENG:308": "Jen společně\rOrdosy porazíme!",
    "DUNE.ENG:309": "V imperátorově paláci.",
    "DUNE.ENG:310": "Dostanete pomoc,\ro kterou žádáte, a pak selžete!",
    "DUNE.ENG:311": "Ne, Vaše...",
    "DUNE.ENG:312": "Moji Sardaukaři mohli porazit\rHarkonneny, ale vy jste je obětovali!",
    "DUNE.ENG:313": "Neměli jsme...",
    "DUNE.ENG:314": "Nechci slyšet výmluvy.\rZnovu mě nezklamte!",
    "DUNE.ENG:315": "V imperátorově paláci\rna Duně.",
    "DUNE.ENG:316": "Měl jsem vědět, že vaše rody\rHarkonnenům neodolají!",
    "DUNE.ENG:317": "Excelence, oni jsou...",
    "DUNE.ENG:318": "Ticho!",
    "DUNE.ENG:319": "Budete bránit můj palác.",
    "DUNE.ENG:320": "Ukážu vám, jak\rHarkonneny rozdrtit!",
    "DUNE.ENG:321": "Děkujeme, že hrajete Dune II.",
    "DUNE.ENG:322": "Sila se plní. Postavte další.",
    "DUNE.ENG:323": "Jméno a hodnost",
    "DUNE.ENG:324": "Bitva",
    "DUNE.ENG:325": "Skóre",
    "DUNE.ENG:326": "Pokračovat",
    "DUNE.ENG:327": "Smazat seznam",
    "DUNE.ENG:328": "Opravdu chcete smazat nejlepší výsledky?",
    "DUNE.ENG:329": "Vy:",
    "DUNE.ENG:330": "Nepřítel:",
    "DUNE.ENG:331": "Docházejí kredity. Další získáte těžbou koření.",
    "DUNE.ENG:332": "Radar nemá dost energie.  Postavte větrné elektrárny.",
    "DUNE.ENG:333": "Nejprve opravte budovu",
    "DUNE.ENG:334": "Síň slávy",
    "DUNE.ENG:335": "Vyberte\rmísto pro\rtěžbu.",
    "DUNE.ENG:336": "Síň slávy",
    "DUNE.ENG:337": "Nejsou žádné uložené hry k načtení.",
    "DUNE.ENG:338": "Pozor: Původní uložené hry nejsou slučitelné s novou verzí.  Bitva začne znovu.",
    "DUNE.ENG:339": " ",
    "MESSAGE.ENG:000": "",
    "MESSAGE.ENG:001": "Postavte větrnou elektrárnu, která dodá základně energii.  Bez energie budou vaše budovy chátrat.",
    "MESSAGE.ENG:002": "Beton: Z betonových desek vytvoříte pevné základy pro své budovy.",
    "MESSAGE.ENG:003": "Palác: Toto je váš palác.",
    "MESSAGE.ENG:004": "Lehká továrna: Vyrábí lehká bojová vozidla.",
    "MESSAGE.ENG:005": "Těžká továrna: Vyrábí pásová vozidla.",
    "MESSAGE.ENG:006": "Hi-tech továrna: Vyrábí létající stroje.",
    "MESSAGE.ENG:007": "Středisko IX: Výzkumné středisko IX zdokonaluje technologie vašeho rodu.",
    "MESSAGE.ENG:008": "WOR: Slouží k výcviku těžké pěchoty.",
    "MESSAGE.ENG:009": "Stavební dvůr: Zajišťuje výstavbu všech budov.",
    "MESSAGE.ENG:010": "Větrná elektrárna: Dodává základně energii.  Bez energie budou vaše budovy chátrat.",
    "MESSAGE.ENG:011": "Kasárna: Slouží k výcviku lehké pěchoty.",
    "MESSAGE.ENG:012": "Kosmodrom: Umožňuje objednávat a přijímat dodávky od společnosti C.H.O.A.M.",
    "MESSAGE.ENG:013": "Rafinérie koření: Přeměňuje koření na kredity.",
    "MESSAGE.ENG:014": "Opravna: Slouží k opravám vašich vozidel.",
    "MESSAGE.ENG:015": "Zeď: Slouží k pasivní obraně základny.",
    "MESSAGE.ENG:016": "Dělová věž: Zajišťuje aktivní obranu na krátkou vzdálenost.",
    "MESSAGE.ENG:017": "Raketová věž: Její rakety a dělo zajišťují obranu na krátkou i střední vzdálenost.",
    "MESSAGE.ENG:018": "Silo: Slouží ke skladování zpracovaného koření.",
    "MESSAGE.ENG:019": "Radarová základna: Poskytuje radar a usnadňuje řízení vzdálených vozidel.",
    "MESSAGE.ENG:020": "Pro tuto budovu není dost volných betonových základů.  Můžete ji přesto umístit, ale bez dostatku betonu bude potřebovat opravu.",
    "MESSAGE.ENG:021": "Písek: Tohle je písečný terén.  Toho je na Arrakisu opravdu dost.",
    "MESSAGE.ENG:022": "Písečné duny: Nedílná součást krajiny Arrakisu.",
    "MESSAGE.ENG:023": "Skála: Cenný skalnatý terén je jediným místem, kde lze stavět budovy.",
    "MESSAGE.ENG:024": "Hora: Hory jsou na Arrakisu vzácné (a překážejí).",
    "MESSAGE.ENG:025": "Pole koření: Tohle je koření.  Je to nejcennější látka ve vesmíru.",
    "MESSAGE.ENG:026": "Budovy se musí umisťovat na volnou skálu nebo beton a vedle jiné vlastní budovy.",
    "MESSAGE.ENG:027": "Vyhledejte pole koření, kde lze zahájit těžbu.",
    "MESSAGE.ENG:028": "Pozor: Po Duně se potulují píseční červi (Šaj-hulúd) a požírají vše na písku.",
    "MESSAGE.ENG:029": "",
    "INTRO.ENG:000": "",
    "INTRO.ENG:001": "uvádějí",
    "INTRO.ENG:002": "Budování dynastie",
    "INTRO.ENG:003": "Planeta Arrakis, známá jako Duna.",
    "INTRO.ENG:004": "Země písku.",
    "INTRO.ENG:005": "Domov koření.",
    "INTRO.ENG:006": "Koření ovládá impérium.",
    "INTRO.ENG:007": "Kdo ovládá Dunu,\rovládá koření.",
    "INTRO.ENG:008": "Imperátor vyhlásil\rvšem rodům výzvu.",
    "INTRO.ENG:009": "Rod, který vytěží nejvíce\rkoření, získá vládu nad Dunou.",
    "INTRO.ENG:010": "Území nejsou stanovena.",
    "INTRO.ENG:011": "A neplatí žádná pravidla boje.",
    "INTRO.ENG:012": "Dorazily obrovské armády.",
    "INTRO.ENG:013": "Nyní tři rody bojují\ro vládu nad Dunou.",
    "INTRO.ENG:014": "Ušlechtilí Atreidové.",
    "INTRO.ENG:015": "Zákeřní Ordosové.",
    "INTRO.ENG:016": "A krutí Harkonnenové.",
    "INTRO.ENG:017": "Zvítězit může jen jeden rod.",
    "INTRO.ENG:018": "Váš boj o Dunu začíná",
    "INTRO.ENG:019": " TEĎ",
    "INTRO.ENG:020": "Zdravím vás, imperátore.",
    "INTRO.ENG:021": "Co má znamenat\rtoto vniknutí?",
    "INTRO.ENG:022": "Jste obviněn ze zrady\rvůči rodu Atreidů.",
    "INTRO.ENG:023": "Náš rod rozhodne\ro vaší vině či nevině.",
    "INTRO.ENG:024": "Do té doby již nebudete\rvládnout jako imperátor.",
    "INTRO.ENG:025": "Své slovo jste, imperátore,\rzrovna nedodržel.",
    "INTRO.ENG:026": "Lhal jste nám.",
    "INTRO.ENG:027": "Jaké lži?  O čem\rto mluvíte?",
    "INTRO.ENG:028": "Vaše lži o věrnosti!\rVáš podvod!",
    "INTRO.ENG:029": "Za tento zločin\rdraze zaplatíte...",
    "INTRO.ENG:030": "...vlastním životem!",
    "INTRO.ENG:031": "NE!  NE!  NÉÉÉ!",
    "INTRO.ENG:032": "Víte, imperátore, že vaše\rhry už nás unavují.",
    "INTRO.ENG:033": "Jaké hry?  O čem\rto mluvíte?",
    "INTRO.ENG:034": "Mluvím o\rvaší šachové partii.",
    "INTRO.ENG:035": "Byli jsme vašimi pěšáky\ra Duna byla šachovnicí.",
    "INTRO.ENG:036": "Rozhodli jsme se vzít\rvěci do vlastních rukou.",
    "INTRO.ENG:037": "Teď budete naším pěšákem\rv naší hře.",
    "INTRO.ENG:038": "",
