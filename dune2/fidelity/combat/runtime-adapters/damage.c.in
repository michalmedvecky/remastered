@@Unit_GetHouseID@@
@@Tools_Random_256@@
@@Tools_Random_Seed@@
void run_damage(const uint16*in,uint16*out){
 memset(&target,0,sizeof target);memset(out,0,48);log_out=out;out[14]=out[15]=65535;
 target.o.type=in[0];target.o.hitpoints=in[1];target.o.houseID=in[4];g_playerHouseID=in[5];g_campaignID=in[6];target.deviated=in[7];Tools_Random_Seed(in[8]|(uint32)in[9]<<16);target.o.flags.all=in[10];target.actionID=in[11];target.amount=in[12];target.targetAttack=in[13];target.targetMove=in[14];target.spriteOffset=5;target.timer=123;target.o.position.x=target.o.position.y=0x1080;
 out[0]=Unit_Damage(&target,in[2],in[3]);out[1]=target.o.hitpoints;out[2]=target.o.type;out[3]=target.o.flags.all&65535;out[4]=target.deviated;out[5]=target.actionID;out[8]=s_randomSeed[0]|s_randomSeed[1]<<8;out[9]=s_randomSeed[2]|s_randomSeed[3]<<8;out[10]=Unit_GetHouseID(&target);out[11]=(uint8)target.spriteOffset;out[12]=target.timer;out[18]=target.targetAttack;out[19]=target.targetMove;
}
