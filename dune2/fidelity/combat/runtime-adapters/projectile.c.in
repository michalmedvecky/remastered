void run_projectile(const uint16*in,uint16*out){
 memset(&projectile,0,sizeof projectile);memset(&target,0,sizeof target);memset(&building,0,sizeof building);memset(g_map,0,sizeof g_map);memset(out,0,256);log_out=out;log_cursor=13;
 projectile.o.type=in[0];projectile.o.hitpoints=in[1];projectile.fireDelay=in[2];projectile.orientation[0].current=in[3];projectile.o.position.x=in[5];projectile.o.position.y=in[6];projectile.currentDestination.x=in[7];projectile.currentDestination.y=in[8];projectile.distanceToDestination=in[9];projectile.o.flags.all=3;projectile.o.houseID=1;projectile.originEncoded=in[15];landscape_type=in[10];target_kind=in[11];target.o.type=in[12];Tools_Random_Seed(in[13]|(uint32)in[14]<<16);
 out[0]=Unit_Move(&projectile,in[4]);out[1]=projectile.o.position.x;out[2]=projectile.o.position.y;out[3]=projectile.o.hitpoints;out[4]=projectile.o.flags.all&65535;out[5]=projectile.distanceToDestination;out[11]=s_randomSeed[0]|s_randomSeed[1]<<8;out[12]=s_randomSeed[2]|s_randomSeed[3]<<8;
}
